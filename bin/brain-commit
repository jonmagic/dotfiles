#!/bin/bash
set -euo pipefail

export MISE_GLOBAL_CONFIG_FILE="${MISE_GLOBAL_CONFIG_FILE:-$HOME/.config/mise/config.toml}"
export MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES="${MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES:-none}"
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin"
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"
export GIT_TERMINAL_PROMPT=0
ssh-add --apple-use-keychain ~/.ssh/jonmagic_github 2>/dev/null || true
COPILOT="$(command -v copilot || true)"
if [ -z "$COPILOT" ]; then
  echo "$(date): copilot executable not found" >> /tmp/brain-commit.log
  exit 1
fi
LOCK="/tmp/brain-commit.lock"
LOG="/tmp/brain-commit.log"
TIMEOUT=900
BRAIN_DIR="${BRAIN_DIR:-$HOME/Brain}"
EXPECTED_MANIFEST=""
VERIFY_SYNC="$HOME/.agents/skills/brain/scripts/verify-sync.sh"

cleanup() {
  rm -f "$LOCK"
  if [ -n "${EXPECTED_MANIFEST:-}" ] && [ -f "$EXPECTED_MANIFEST" ]; then
    rm -f "$EXPECTED_MANIFEST"
  fi
}

cleanup_brain_commit_sessions() {
  local session_state_dir="$HOME/.copilot/session-state"

  # Remove Brain commit-agent session directories from both current and prior runs.
  # The workspace metadata uses `name`, while the SQLite session index uses `summary`.
  if [ -d "$session_state_dir" ]; then
    find "$session_state_dir" -maxdepth 2 -mindepth 2 -name workspace.yaml -type f -print0 2>/dev/null | \
      while IFS= read -r -d '' workspace_file; do
        session_dir="$(dirname "$workspace_file")"
        if grep -Fxq "cwd: $BRAIN_DIR" "$workspace_file" && \
           grep -Fxq 'repository: jonmagic/brain' "$workspace_file" && \
           grep -Fxq 'name: commit brain' "$workspace_file" && \
           grep -Fxq 'user_named: false' "$workspace_file"; then
          rm -rf "$session_dir"
          echo "$(date): removed copilot session state $session_dir" >> "$LOG"
        fi
      done
  fi

  # Remove "commit brain" sessions from session-store.db so they don't
  # clutter copilot-sessions search results
  local session_db="$HOME/.copilot/session-store.db"
  if [ -f "$session_db" ] && command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "$session_db" "
      PRAGMA busy_timeout = 5000;
      DELETE FROM search_index WHERE session_id IN (SELECT id FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain');
      DELETE FROM session_refs WHERE session_id IN (SELECT id FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain');
      DELETE FROM session_files WHERE session_id IN (SELECT id FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain');
      DELETE FROM checkpoints WHERE session_id IN (SELECT id FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain');
      DELETE FROM turns WHERE session_id IN (SELECT id FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain');
      DELETE FROM sessions WHERE cwd = '$BRAIN_DIR' AND repository = 'jonmagic/brain' AND summary = 'commit brain';
    " >/dev/null 2>/dev/null && \
      echo "$(date): cleaned commit brain sessions from session-store.db" >> "$LOG" || \
      echo "$(date): failed to clean session-store.db" >> "$LOG"
  fi
}

# Prevent overlapping runs
if [ -f "$LOCK" ]; then
  pid=$(cat "$LOCK")
  if kill -0 "$pid" 2>/dev/null; then
    echo "$(date): skipping, previous run (pid $pid) still active" >> "$LOG"
    exit 0
  fi
  rm -f "$LOCK"
fi

echo $$ > "$LOCK"
trap cleanup EXIT

echo "$(date): starting brain commit" >> "$LOG"
cd "$BRAIN_DIR" || exit 1

# Keep Copilot's shared home for auth and installed skills, but trim old daemon logs.
find "$HOME/.copilot/logs" -maxdepth 1 -type f -name 'process-*.log' -mtime +7 -delete 2>/dev/null || true
cleanup_brain_commit_sessions

if [ ! -x "$VERIFY_SYNC" ]; then
  echo "$(date): Brain sync verifier is missing or not executable: $VERIFY_SYNC" >> "$LOG"
  exit 1
fi

EXPECTED_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/brain-expected-paths.XXXXXX")"
{
  git diff --no-renames --name-only -z
  git diff --cached --no-renames --name-only -z
  git ls-files --others --exclude-standard -z
} | while IFS= read -r -d '' path; do
  if [ -e "$path" ] || [ -L "$path" ]; then
    if [ -L "$path" ]; then
      blob="$(printf '%s' "$(readlink "$path")" | git hash-object --stdin)"
    else
      blob="$(git hash-object "$path")"
    fi
    printf 'present\0%s\0%s\0' "$path" "$blob"
  else
    printf 'absent\0%s\0\0' "$path"
  fi
done > "$EXPECTED_MANIFEST"

verify_sync() {
  local state path blob
  local verify_args=()

  while IFS= read -r -d '' state &&
        IFS= read -r -d '' path &&
        IFS= read -r -d '' blob; do
    case "$state" in
      present)
        verify_args+=(--present "$path" "$blob")
        ;;
      absent)
        verify_args+=(--absent "$path")
        ;;
      *)
        echo "$(date): invalid expected-path state: $state" >> "$LOG"
        return 1
        ;;
    esac
  done < "$EXPECTED_MANIFEST"

  if [ "${#verify_args[@]}" -eq 0 ]; then
    "$VERIFY_SYNC" >> "$LOG" 2>&1
  else
    "$VERIFY_SYNC" "${verify_args[@]}" >> "$LOG" 2>&1
  fi
}

# Skip if nothing to commit
if [ -z "$(git status --porcelain)" ]; then
  git pull --rebase --autostash >> "$LOG" 2>&1 || {
    echo "$(date): pull had conflicts or errors, aborting rebase" >> "$LOG"
    git rebase --abort >> "$LOG" 2>&1 || true
  }
  # Push any committed-but-unpushed changes
  if [ -n "$(git log origin/main..HEAD --oneline 2>/dev/null)" ]; then
    git push >> "$LOG" 2>&1 && \
      echo "$(date): pushed unpushed commits" >> "$LOG" || \
      echo "$(date): push failed" >> "$LOG"
  fi
  if ! verify_sync; then
    echo "$(date): GitHub verification failed" >> "$LOG"
    exit 1
  fi
  echo "$(date): verified GitHub main" >> "$LOG"
  echo "$(date): nothing to commit" >> "$LOG"
  exit 0
fi

GH_AUTH_TOKEN=""
GH_AUTH_SOURCE=""
if command -v gh >/dev/null 2>&1; then
  GH_AUTH_TOKEN="$(gh auth token 2>/dev/null || true)"
  if [ -n "$GH_AUTH_TOKEN" ]; then
    GH_AUTH_SOURCE="gh cli"
  fi
fi

if [ -z "$GH_AUTH_TOKEN" ] && command -v security >/dev/null 2>&1; then
  GH_AUTH_TOKEN="$(security find-generic-password -s "gh:${GH_HOST:-github.com}" -a "${USER}" -w 2>/dev/null || true)"
  if [ -n "$GH_AUTH_TOKEN" ]; then
    GH_AUTH_SOURCE="keychain gh"
  fi
fi

if [ -z "$GH_AUTH_TOKEN" ] && command -v security >/dev/null 2>&1; then
  GH_AUTH_TOKEN="$(security find-internet-password -s "${GH_HOST:-github.com}" -a "${USER}" -w 2>/dev/null || true)"
  if [ -n "$GH_AUTH_TOKEN" ]; then
    GH_AUTH_SOURCE="keychain internet"
  fi
fi

copilot_env=()
if [ -n "$GH_AUTH_TOKEN" ]; then
  copilot_env+=("GH_TOKEN=$GH_AUTH_TOKEN")
  echo "$(date): using ${GH_AUTH_SOURCE} token for copilot" >> "$LOG"
else
  echo "$(date): gh auth token unavailable, using default copilot home auth state" >> "$LOG"
fi

run_copilot() {
  if [ "${#copilot_env[@]}" -eq 0 ]; then
    exec "$COPILOT" "$@"
  else
    exec env "${copilot_env[@]}" "$COPILOT" "$@"
  fi
}

run_copilot \
    --available-tools bash read_bash write_bash stop_bash list_bash view glob grep skill \
    --disable-builtin-mcps \
    --disable-mcp-server datadog \
    --disable-mcp-server Sentry \
    --allow-all-tools \
    --add-dir ~/Brain \
    --add-dir ~/.agents/skills/brain \
    -p "commit brain" >> "$LOG" 2>&1 &
copilot_pid=$!

# Kill copilot if it exceeds the timeout
(sleep "$TIMEOUT" && kill "$copilot_pid" 2>/dev/null) &
timer_pid=$!

if wait "$copilot_pid" 2>/dev/null; then
  status=0
else
  status=$?
fi

# Cancel the timer if copilot finished in time
kill "$timer_pid" 2>/dev/null || true
wait "$timer_pid" 2>/dev/null || true

if [ $status -eq 143 ]; then
  echo "$(date): timed out after ${TIMEOUT}s" >> "$LOG"
elif [ $status -ne 0 ]; then
  echo "$(date): exited with status $status" >> "$LOG"
else
  echo "$(date): completed successfully" >> "$LOG"
fi

cleanup_brain_commit_sessions

if ! verify_sync; then
  echo "$(date): GitHub verification failed; expected paths were not fully synchronized" >> "$LOG"
  exit 1
fi
echo "$(date): verified all expected paths on GitHub main" >> "$LOG"
