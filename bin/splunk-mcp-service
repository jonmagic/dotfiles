#!/usr/bin/env bash
# Run one native Splunk MCP service for all Copilot CLI sessions.
set -euo pipefail

ROOT="${SPLUNK_MCP_ROOT:-$HOME/github/splunk-mcp-server}"
ENV_FILE="${SPLUNK_MCP_ENV_FILE:-$HOME/.config/splunk-mcp/splunk-mcp.env}"
PYTHON="${SPLUNK_MCP_PYTHON:-$ROOT/.venv/bin/python}"

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Splunk MCP environment file is missing or unreadable: $ENV_FILE" >&2
  exit 1
fi

if [[ ! -x "$PYTHON" ]]; then
  echo "Splunk MCP runtime is missing: $PYTHON" >&2
  echo "Run 'uv sync --frozen --no-dev' in $ROOT" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

cd "$ROOT"
exec "$PYTHON" splunk_mcp.py sse
