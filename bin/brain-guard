#!/bin/bash
# Coordinates the 5-minute brain-commit launchd timer with interactive editing
# sessions on the Brain repo. An agent doing a multi-file edit burst should
# `acquire` a guard before editing and `release` it right after committing, so
# brain-commit skips its cycle instead of racing a partial commit mid-edit.
#
# The guard is a plain staleness marker, not a live-process lock: brain-commit
# ignores it once it is older than GUARD_MAX_AGE seconds, so a forgotten
# release never blocks automation forever.
set -euo pipefail

GUARD="/tmp/brain-commit.guard"
cmd="${1:-status}"
reason="${2:-manual edit session}"

case "$cmd" in
  acquire)
    printf '%s\n%s\n%s\n' "$$" "$(date +%s)" "$reason" > "$GUARD"
    echo "brain-guard acquired: $reason"
    ;;
  refresh)
    if [ -f "$GUARD" ]; then
      pid="$(sed -n '1p' "$GUARD")"
      r="$(sed -n '3p' "$GUARD")"
      printf '%s\n%s\n%s\n' "$pid" "$(date +%s)" "$r" > "$GUARD"
      echo "brain-guard refreshed: $r"
    else
      echo "no active brain-guard to refresh" >&2
      exit 1
    fi
    ;;
  release)
    rm -f "$GUARD"
    echo "brain-guard released"
    ;;
  status)
    if [ -f "$GUARD" ]; then
      ts="$(sed -n '2p' "$GUARD")"
      r="$(sed -n '3p' "$GUARD")"
      age=$(( $(date +%s) - ts ))
      echo "brain-guard active (${age}s old): $r"
    else
      echo "no active brain-guard"
    fi
    ;;
  *)
    echo "usage: brain-guard {acquire [reason]|refresh|release|status}" >&2
    exit 1
    ;;
esac
