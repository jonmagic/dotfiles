#!/bin/bash
# Coordinates the 5-minute brain-commit launchd timer with interactive editing
# sessions on the Brain repo, on a per-file basis. Acquire the guard on the
# specific paths you're actively editing; brain-commit stashes just those
# paths out of the way before committing everything else, then restores them
# untouched. Other dirty files keep committing/pushing on the normal cycle.
#
# The guard is a staleness marker, not a live-process lock: brain-commit
# ignores/removes it once older than GUARD_MAX_AGE seconds, so a forgotten
# release never blocks automation forever.
set -euo pipefail

GUARD="/tmp/brain-commit.guard"
cmd="${1:-status}"

case "$cmd" in
  acquire)
    shift || true
    reason="manual edit session"
    paths=()
    for arg in "$@"; do
      if [ -e "$HOME/Brain/$arg" ] || [ -e "$arg" ]; then
        paths+=("$arg")
      else
        reason="$arg"
      fi
    done
    if [ "${#paths[@]}" -eq 0 ]; then
      echo "usage: brain-guard acquire <path> [path...] [reason]" >&2
      exit 1
    fi
    {
      echo "$$"
      date +%s
      echo "$reason"
      printf '%s\n' "${paths[@]}"
    } > "$GUARD"
    echo "brain-guard acquired for: ${paths[*]} ($reason)"
    ;;
  refresh)
    if [ -f "$GUARD" ]; then
      pid="$(sed -n '1p' "$GUARD")"
      reason="$(sed -n '3p' "$GUARD")"
      paths="$(tail -n +4 "$GUARD")"
      {
        echo "$pid"
        date +%s
        echo "$reason"
        printf '%s\n' "$paths"
      } > "$GUARD"
      echo "brain-guard refreshed: $reason"
    else
      echo "no active brain-guard to refresh" >&2
      exit 1
    fi
    ;;
  release)
    rm -f "$GUARD"
    echo "brain-guard released"
    ;;
  status)
    if [ -f "$GUARD" ]; then
      ts="$(sed -n '2p' "$GUARD")"
      reason="$(sed -n '3p' "$GUARD")"
      age=$(( $(date +%s) - ts ))
      echo "brain-guard active (${age}s old): $reason"
      echo "guarded paths:"
      tail -n +4 "$GUARD" | sed 's/^/  /'
    else
      echo "no active brain-guard"
    fi
    ;;
  *)
    echo "usage: brain-guard {acquire <path>... [reason]|refresh|release|status}" >&2
    exit 1
    ;;
esac
