#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MACHINE_CREDENTIALS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/copilot-keychain-credentials"
CREDENTIALS_FILE="${COPILOT_KEYCHAIN_CREDENTIALS_FILE:-$MACHINE_CREDENTIALS_FILE}"

if [[ ! -e "$CREDENTIALS_FILE" && -z "${COPILOT_KEYCHAIN_CREDENTIALS_FILE:-}" ]]; then
  CREDENTIALS_FILE="$ROOT_DIR/sources/copilot-keychain-credentials"
fi

load_keychain_credentials() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0

  local security_bin="${SECURITY_BIN:-/usr/bin/security}"
  local default_account="${USER:-}"
  local line_number=0
  local label env_var service account requirement extra secret

  if [[ ! -x "$security_bin" ]]; then
    echo "macOS Keychain helper not found: $security_bin" >&2
    exit 1
  fi

  if [[ ! -r "$CREDENTIALS_FILE" ]]; then
    echo "Copilot Keychain credential manifest not found: $CREDENTIALS_FILE" >&2
    exit 1
  fi

  if [[ -z "$default_account" ]]; then
    default_account="$(id -un)"
  fi

  while IFS='|' read -r label env_var service account requirement extra ||
    [[ -n "${label}${env_var}${service}${account}${requirement}${extra}" ]]; do
    ((line_number += 1))
    requirement="${requirement%$'\r'}"

    if [[ -z "${label//[[:space:]]/}" && -z "${env_var}${service}${account}${requirement}${extra}" ]]; then
      continue
    fi

    if [[ "$label" == \#* ]]; then
      continue
    fi

    if [[ -n "$extra" || -z "$label" || -z "$env_var" || -z "$service" || -z "$requirement" ]]; then
      echo "Invalid Copilot credential manifest entry at $CREDENTIALS_FILE:$line_number." >&2
      exit 1
    fi

    if [[ ! "$env_var" =~ ^COPILOT_MCP_[A-Z0-9_]+$ ]]; then
      echo "Invalid Copilot credential environment variable '$env_var' at $CREDENTIALS_FILE:$line_number." >&2
      exit 1
    fi

    case "$requirement" in
      required|optional) ;;
      *)
        echo "Invalid Copilot credential requirement '$requirement' at $CREDENTIALS_FILE:$line_number." >&2
        exit 1
        ;;
    esac

    account="${account:-$default_account}"
    unset "$env_var"
    secret=""

    if ! secret="$("$security_bin" find-generic-password \
      -a "$account" \
      -s "$service" \
      -w 2>/dev/null)"; then
      if [[ "$requirement" == "optional" ]]; then
        continue
      fi

      echo "$label credential not found in macOS Keychain." >&2
      echo "Add it under service '$service' and account '$account'." >&2
      exit 1
    fi

    if [[ -z "$secret" ]]; then
      if [[ "$requirement" == "optional" ]]; then
        continue
      fi

      echo "$label credential in macOS Keychain is empty." >&2
      exit 1
    fi

    printf -v "$env_var" '%s' "$secret"
    export "$env_var"
    unset secret
  done <"$CREDENTIALS_FILE"
}

run_copilot() {
  local node_bin="$1"
  local npm_loader="$2"
  shift 2

  if [[ -x "$node_bin" && -f "$npm_loader" ]]; then
    exec "$node_bin" "$npm_loader" "$@"
  fi
}

load_keychain_credentials

if [[ -n "${COPILOT_BIN:-}" ]]; then
  if [[ ! -x "$COPILOT_BIN" ]]; then
    echo "Configured Copilot executable is not executable: $COPILOT_BIN" >&2
    exit 127
  fi

  exec "$COPILOT_BIN" "$@"
fi

# GitHub Copilot CLI — use a known global install instead of project-local
# shims, so `c` keeps working inside repos with their own toolchain pins.
for homebrew_prefix in /opt/homebrew /usr/local; do
  run_copilot \
    "$homebrew_prefix/bin/node" \
    "$homebrew_prefix/lib/node_modules/@github/copilot/npm-loader.js" \
    "$@"
done

shopt -s nullglob

mise_nodes=("$HOME"/.local/share/mise/installs/node/*)
for ((i=${#mise_nodes[@]} - 1; i >= 0; i--)); do
  run_copilot \
    "${mise_nodes[$i]}/bin/node" \
    "${mise_nodes[$i]}/lib/node_modules/@github/copilot/npm-loader.js" \
    "$@"
done

nvm_nodes=("${NVM_DIR:-$HOME/.nvm}"/versions/node/*)
for ((i=${#nvm_nodes[@]} - 1; i >= 0; i--)); do
  run_copilot \
    "${nvm_nodes[$i]}/bin/node" \
    "${nvm_nodes[$i]}/lib/node_modules/@github/copilot/npm-loader.js" \
    "$@"
done

fnm_nodes=("$HOME"/.local/share/fnm/node-versions/*/installation)
for ((i=${#fnm_nodes[@]} - 1; i >= 0; i--)); do
  run_copilot \
    "${fnm_nodes[$i]}/bin/node" \
    "${fnm_nodes[$i]}/lib/node_modules/@github/copilot/npm-loader.js" \
    "$@"
done

volta_copilot_loaders=("$HOME"/.volta/tools/image/packages/@github/copilot/lib/node_modules/@github/copilot/npm-loader.js)
for npm_loader in "${volta_copilot_loaders[@]}"; do
  for node_bin in "$HOME"/.volta/tools/image/node/*/bin/node "$HOME"/.volta/bin/node; do
    run_copilot "$node_bin" "$npm_loader" "$@"
  done
done

shopt -u nullglob

if command -v npm >/dev/null 2>&1; then
  npm_root="$(npm root -g 2>/dev/null || true)"
  if [[ -n "$npm_root" && -f "$npm_root/@github/copilot/npm-loader.js" ]]; then
    exec node "$npm_root/@github/copilot/npm-loader.js" "$@"
  fi
fi

echo "GitHub Copilot CLI is not installed in Homebrew or global npm." >&2
echo "Run: npm install -g @github/copilot@prerelease" >&2
exit 127
